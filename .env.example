# Crypto Data Collector Environment Variables

# API Keys (опционально)
COINGECKO_API_KEY=your_coingecko_api_key_here
NANSEN_API_KEY=your_nansen_api_key_here

# Telegram Bot (для отправки отчётов)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Прокси для парсеров (рекомендуется)
# HTTP_PROXY=http://user:pass@proxy:port
# HTTPS_PROXY=http://user:pass@proxy:port

# Cookie файлы для авторизованных парсеров
# ARKHAM_COOKIE_PATH=/path/to/arkham_cookies.json
# TOKENTERMINAL_COOKIE_PATH=/path/to/tt_cookies.json
# TWEETSCOUT_COOKIE_PATH=/path/to/tweetscout_cookies.json

# Настройки
# COLLECTION_INTERVAL_MINUTES=240
# ALERT_COOLDOWN_MINUTES=30
